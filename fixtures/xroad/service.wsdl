<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/"
        xmlns:hdr="http://example.com/xsd/header.xsd"
        xmlns="http://example.com/xroad"
        targetNamespace="http://example.com/xroad"
        name="xroadDefinitions">
    <wsdl:types>
        <xsd:schema targetNamespace="http://example.com/xroad">
            <xsd:import namespace="http://example.com/xsd/header.xsd" schemaLocation="xroad-header.xsd"/>
            <xsd:simpleType name="insuranceKindType">
                <xsd:restriction base="xsd:integer">
                    <xsd:enumeration value="1"/>
                    <xsd:enumeration value="2"/>
                </xsd:restriction>
            </xsd:simpleType>
            <xsd:simpleType name="rateType">
                <xsd:restriction base="xsd:decimal">
                    <xsd:enumeration value="0.5"/>
                    <xsd:enumeration value="1.25"/>
                </xsd:restriction>
            </xsd:simpleType>
            <xsd:simpleType name="derivedKindType">
                <xsd:restriction base="insuranceKindType">
                    <xsd:enumeration value="1"/>
                </xsd:restriction>
            </xsd:simpleType>
            <xsd:simpleType name="genderType">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="M"/>
                    <xsd:enumeration value="N"/>
                </xsd:restriction>
            </xsd:simpleType>
            <xsd:complexType name="errorListType">
                <xsd:sequence>
                    <xsd:element name="error" type="xsd:string" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="submitRequestType">
                <xsd:sequence>
                    <xsd:element name="kind" type="insuranceKindType"/>
                    <xsd:element name="rate" type="rateType" minOccurs="0"/>
                    <xsd:element name="gender" type="genderType" minOccurs="0"/>
                    <xsd:element name="derived" type="derivedKindType" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="submitResponseType">
                <xsd:sequence>
                    <xsd:element name="errors" type="errorListType" minOccurs="0"/>
                    <xsd:element name="message" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:element name="submit">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="request" type="submitRequestType"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="submitResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="request" type="submitRequestType"/>
                        <xsd:element name="response" type="submitResponseType"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="hdr:client"/>
        <wsdl:part name="userId" element="hdr:userId"/>
    </wsdl:message>
    <wsdl:message name="submit">
        <wsdl:part name="body" element="submit"/>
        <wsdl:part name="attachment" type="xsd:base64Binary"/>
    </wsdl:message>
    <wsdl:message name="submitResponse">
        <wsdl:part name="body" element="submitResponse"/>
    </wsdl:message>
    <wsdl:portType name="xroadPortType">
        <wsdl:operation name="submit">
            <wsdl:input message="submit"/>
            <wsdl:output message="submitResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="xroadBinding" type="xroadPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="submit">
            <soap:operation soapAction="" style="document"/>
            <wsdl:input>
                <mime:multipartRelated>
                    <mime:part>
                        <soap:body parts="body" use="literal"/>
                        <soap:header message="requestHeader" part="client" use="literal"/>
                        <soap:header message="requestHeader" part="userId" use="literal"/>
                    </mime:part>
                    <mime:part>
                        <mime:content part="attachment" type="application/octet-stream"/>
                    </mime:part>
                </mime:multipartRelated>
            </wsdl:input>
            <wsdl:output>
                <soap:body parts="body" use="literal"/>
                <soap:header message="requestHeader" part="client" use="literal"/>
                <soap:header message="requestHeader" part="userId" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadService">
        <wsdl:port name="xroadPort" binding="xroadBinding">
            <soap:address location="http://localhost/cgi-bin/consumer_proxy"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
